# EditorConfig helps maintain consistent coding styles
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Don't auto-format Jinja2 templates
[templates/*.html]
indent_size = 2
trim_trailing_whitespace = false
